<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Мой Еженедельник</title>
    <style>
        body { font-family:Arial,sans-serif; margin:0; padding:15px; display:flex; flex-direction:column; min-height:95vh; user-select:none; }
        .header-container { display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; }
        h1 { margin:0; color:#ff9800; font-size:1.6em; }
        .theme-selector button { border:1px solid #555; padding:5px 10px; margin-left:4px; border-radius:4px; cursor:pointer; font-weight:bold; }
        .theme-selector button.active { background:#ff9800 !important; color:white !important; border-color:#ff9800 !important; }
        .planner-grid { display: block; width: 100%; clear: both; }
        .day-column { float: left; border-radius:6px; padding:6px; box-sizing:border-box; border:2px solid transparent; margin-bottom: 10px; }
        .day-column.today { border-color:#ff9800 !important; }
        .extra-section { clear: both; margin-top: 15px; border-radius:6px; padding:8px; }
        .extra-grid { display: block; width: 100%; clear: both; }
        .extra-item { float: left; box-sizing:border-box; margin-bottom: 8px; }
        @media (min-width: 1201px) { .day-column { width: 13.7%; margin: 0 0.25%; } .extra-item { width: 24.5%; margin: 0 0.25%; } }
        @media (max-width: 1200px) and (min-width: 769px) { .day-column { width: 24.5%; margin: 0 0.25%; } .extra-item { width: 49.5%; margin: 0 0.25%; } }
        @media (max-width: 768px) and (min-width: 481px) { .day-column { width: 49.5%; margin: 0 0.25%; } .extra-item { width: 49.5%; margin: 0 0.25%; } }
        @media (max-width: 480px) { .day-column { width: 100%; margin: 0 0 10px 0; } .extra-item { width: 100%; margin: 0 0 8px 0; } }
        .day-header, .section-header { text-align:center; font-weight:bold; font-size:1em; margin-bottom:10px; padding-bottom:4px; border-bottom:2px solid #ff9800; text-transform:lowercase; }
        .extra-section .section-header { text-transform:none; }
        .row-container { display:flex; align-items:center; gap:4px; margin-bottom:4px; }
        .task-num { font-size:0.8em; color:#aaa; min-width:14px; text-align:right; }
        .task-checkbox { width:15px; height:15px; cursor:pointer; }
        .task-time { width:38px; border:1px solid #555; padding:3px 1px; border-radius:4px; font-size:0.8em; text-align:center; }
        .task-input { flex-grow:1; border:1px solid #555; padding:4px; border-radius:4px; font-size:0.85em; resize:none; height:28px; font-family:Arial,sans-serif; box-sizing:border-box; }
        .weekly-text { color:#ff9800 !important; font-weight:bold !important; border-color:#ff9800 !important; }
        .completed-text { text-decoration:line-through !important; opacity:0.5 !important; }
        .btn-weekly { background-color:#555; border:none; color:white; padding:5px 4px; border-radius:4px; cursor:pointer; font-size:0.7em; }
        .btn-weekly.active { background-color:#4caf50 !important; }
        .footer-controls { clear: both; display:flex; justify-content:space-between; align-items:center; margin-top:15px; padding:8px; border-radius:6px; }
        .live-clock { font-size:1.1em; font-family:monospace; color:#ff9800; font-weight:bold; }
        .btn-reset-all { background-color:#f44336; color:white; border:none; padding:10px 20px; border-radius:4px; font-weight:bold; cursor:pointer; font-size:0.9em; }
    </style>
</head>
<body id="bodyNode">
    <div class="header-container">
        <h1 id="mainTitleNode">Мой Еженедельник (R 1.0.0)</h1>
        <div class="theme-selector">
            <button id="themeBtnBlack" onclick="setTheme('black')">Черный</button>
            <button id="themeBtnGray" onclick="setTheme('gray')">Серый</button>
            <button id="themeBtnWhite" onclick="setTheme('white')">Белый</button>
        </div>
    </div>
    <div class="planner-grid" id="planner"></div>
    <div class="extra-section" id="extraSectionNode">
        <div class="section-header">Дополнительные задачи</div>
        <div class="extra-grid" id="extraGrid"></div>
    </div>
    <div class="footer-controls" id="footerNode">
        <div class="live-clock" id="liveClock"></div>
        <button class="btn-reset-all" id="resetBtn">Сбросить неделю</button>
    </div>
    <script language="JavaScript">
        // 🚨 НАСТРОЙКА ПРОФЕССИОНАЛЬНОГО ЛАУНЧЕРА:
        var LOCAL_VERSION_NUM = 100; // Это технический код версии (1.0.0 -> 100, 1.1.0 -> 110 и т.д.)
        var SERVER_SCRIPT_URL = "https://raw.githubusercontent.com/German1521265/Planner-/refs/heads/main/logicA1.js"; 

        var fso = new ActiveXObject("Scripting.FileSystemObject");
        var shell = new ActiveXObject("WScript.Shell");
        var localLogPath = fso.BuildPath(shell.CurrentDirectory, "logic.js");

        function launchLocalLogic() {
            if (fso.FileExists(localLogPath)) {
                var scriptNode = document.createElement("script");
                scriptNode.language = "JavaScript";
                scriptNode.src = "logic.js";
                document.body.appendChild(scriptNode);
            }
        }

        function checkAndDownloadUpdate() {
            var internetWorks = false;
            var remoteCode = "";

            // Пробуем постучаться в интернет за обновлением
            try {
                var http = new ActiveXObject("MSXML2.XMLHTTP");
                http.open("GET", SERVER_SCRIPT_URL + "?nocache=" + new Date().getTime(), false);
                http.send();
                if (http.status === 200) {
                    remoteCode = http.responseText;
                    internetWorks = true;
                }
            } catch (e) { internetWorks = false; }

            var fileExists = fso.FileExists(localLogPath);

            // Сценарий 1: Самый первый запуск, а интернета НЕТ
            if (!fileExists && !internetWorks) {
                alert("Критическая ошибка: Не обнаружено подключение к интернету!\n\nДля первого запуска и загрузки базовых компонентов приложения требуется подключение к сети.");
                return; // Полностью блокируем работу программы
            }

            // Сценарий 2: Первый запуск с интернетом — молча качаем свежую логику
            if (!fileExists && internetWorks && remoteCode.trim().length > 0) {
                try {
                    var newFile = fso.CreateTextFile(localLogPath, true, true);
                    newFile.Write(remoteCode);
                    newFile.Close();
                } catch(err) {}
                launchLocalLogic();
                return;
            }

            // Сценарий 3: Обычный запуск с интернетом — проверяем, вышло ли обновление
            if (fileExists && internetWorks && remoteCode.trim().length > 0) {
                var localCode = "";
                try {
                    var localFile = fso.OpenTextFile(localLogPath, 1, false, -1);
                    localCode = localFile.ReadAll();
                    localFile.Close();
                } catch(err){}

                // Если код на сервере обновился и отличается от ПК
                if (remoteCode !== localCode) {
                    if (confirm("Внимание! Обнаружена новая, более стабильная версия планировщика.\n\nУстановить обновление? (Ваши личные расписания НЕ будут затронуты).")) {
                        try {
                            var updateFile = fso.CreateTextFile(localLogPath, true, true);
                            updateFile.Write(remoteCode);
                            updateFile.Close();
                            alert("Приложение успешно обновлено до актуального релиза!");
                        } catch(err){}
                    }
                }
            }

            // Запускаем то, что есть локально на ПК
            launchLocalLogic();
        }

        // Запуск умного сетевого лаунчера
        checkAndDownloadUpdate();
    </script>
</body>
</html>
